{
  "OperatorCharacter": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tangent-rpg.bastion/schemas/operator_character.schema.json",
    "title": "Tangent Operator Character Sheet",
    "type": "object",
    "required": [
      "name",
      "power_tier",
      "cp_budget",
      "identity",
      "attributes",
      "saves",
      "pools",
      "skills",
      "features",
      "equipment_udu"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "power_tier": {
        "type": "string",
        "enum": [
          "Tier 1: Operative (150-199 CP)",
          "Tier 2: Tactical (200-299 CP)",
          "Tier 3: Strategic (300-449 CP)",
          "Tier 4: Mythic (450+ CP)"
        ]
      },
      "cp_budget": {
        "type": "object",
        "required": [
          "total_cp_budget",
          "archetype_chassis_cp",
          "customization_cp_spent",
          "personal_hindrance_cp_gained",
          "net_cp_balanced"
        ],
        "properties": {
          "total_cp_budget": {
            "type": "integer",
            "minimum": 150
          },
          "archetype_chassis_cp": {
            "type": "integer",
            "const": 80
          },
          "customization_cp_spent": {
            "type": "integer",
            "minimum": 0
          },
          "personal_hindrance_cp_gained": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "species_disadvantage_cp_refund": {
            "type": "integer",
            "minimum": 0
          },
          "net_cp_balanced": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "identity": {
        "type": "object",
        "required": [
          "species",
          "archetype",
          "faction",
          "origin",
          "occupation"
        ],
        "properties": {
          "species": {
            "type": "string"
          },
          "archetype": {
            "type": "string"
          },
          "faction": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "occupation": {
            "type": "string"
          },
          "mbti_profile": {
            "type": "string"
          }
        }
      },
      "attributes": {
        "type": "object",
        "required": [
          "STR",
          "AGI",
          "STA",
          "INT",
          "WIS",
          "CHA"
        ],
        "properties": {
          "STR": {
            "type": "integer",
            "description": "Strength (Might)"
          },
          "AGI": {
            "type": "integer",
            "description": "Agility (Reflex)"
          },
          "STA": {
            "type": "integer",
            "description": "Stamina (Fortitude & Base Toughness)"
          },
          "INT": {
            "type": "integer",
            "description": "Intellect (Reason)"
          },
          "WIS": {
            "type": "integer",
            "description": "Wisdom (Willpower)"
          },
          "CHA": {
            "type": "integer",
            "description": "Charisma (Etiquette)"
          }
        }
      },
      "saves": {
        "type": "object",
        "description": "Active = 2d10 + 2 + (2 * Attr) + Feature; Passive CR = 12 + (2 * Attr) + Feature",
        "required": [
          "might",
          "reflex",
          "fortitude",
          "reason",
          "willpower",
          "etiquette"
        ],
        "properties": {
          "might": {
            "$ref": "#/$defs/save_pair"
          },
          "reflex": {
            "$ref": "#/$defs/save_pair"
          },
          "fortitude": {
            "$ref": "#/$defs/save_pair"
          },
          "reason": {
            "$ref": "#/$defs/save_pair"
          },
          "willpower": {
            "$ref": "#/$defs/save_pair"
          },
          "etiquette": {
            "$ref": "#/$defs/save_pair"
          }
        }
      },
      "pools": {
        "type": "object",
        "required": [
          "chassis_biology",
          "vitality_max",
          "health_max",
          "structure_max",
          "cp_spent_on_pools",
          "base_toughness_from_sta",
          "stability_points_max",
          "karma_max"
        ],
        "properties": {
          "chassis_biology": {
            "type": "string",
            "enum": [
              "Biological",
              "Synthetic/Construct"
            ]
          },
          "vitality_max": {
            "type": "integer",
            "minimum": 0
          },
          "health_max": {
            "type": "integer",
            "minimum": 0
          },
          "structure_max": {
            "type": "integer",
            "minimum": 0
          },
          "cp_spent_on_pools": {
            "type": "integer",
            "minimum": 0
          },
          "base_toughness_from_sta": {
            "type": "integer"
          },
          "armor_dr_highest_domain": {
            "type": "integer",
            "minimum": 0
          },
          "stability_points_max": {
            "type": "integer",
            "description": "STA + 5"
          },
          "karma_max": {
            "type": "integer",
            "minimum": 0
          },
          "essence_max": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "skills": {
        "type": "object",
        "required": [
          "background_sp_allocated",
          "customization_sp_allocated",
          "entries"
        ],
        "properties": {
          "background_sp_allocated": {
            "type": "integer",
            "const": 60
          },
          "customization_sp_allocated": {
            "type": "integer",
            "minimum": 0
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "skill_name",
                "rank",
                "governing_attribute",
                "total_modifier"
              ],
              "properties": {
                "skill_name": {
                  "type": "string"
                },
                "rank": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 30
                },
                "governing_attribute": {
                  "type": "string",
                  "enum": [
                    "STR",
                    "AGI",
                    "STA",
                    "INT",
                    "WIS",
                    "CHA"
                  ]
                },
                "specialties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "total_modifier": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "features": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "traits": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "hindrances": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "equipment_udu": {
        "type": "object",
        "required": [
          "wealth_score",
          "sockets_used",
          "sockets_max"
        ],
        "properties": {
          "wealth_score": {
            "type": "integer",
            "minimum": 0
          },
          "liquid_credits": {
            "type": "integer",
            "minimum": 0
          },
          "sockets_used": {
            "type": "number",
            "minimum": 0
          },
          "sockets_max": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "$defs": {
      "save_pair": {
        "type": "object",
        "required": [
          "active_bonus",
          "passive_cr"
        ],
        "properties": {
          "active_bonus": {
            "type": "integer"
          },
          "passive_cr": {
            "type": "integer"
          }
        }
      }
    }
  },
  "MechaAndAutomata": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tangent-rpg.bastion/schemas/mecha_automata.schema.json",
    "title": "Tangent Tier 2 Mecha, Vehicle & Automata Stat Block",
    "type": "object",
    "required": [
      "designation",
      "classification",
      "tech_level",
      "faction_skin",
      "size_and_scale",
      "structure_and_defense",
      "udu_mounts",
      "economics",
      "propulsion",
      "loadout"
    ],
    "properties": {
      "designation": {
        "type": "string"
      },
      "classification": {
        "type": "string"
      },
      "tech_level": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5
      },
      "meta_level": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5
      },
      "faction_skin": {
        "type": "string"
      },
      "size_and_scale": {
        "type": "object",
        "required": [
          "size_category",
          "scale_multiplier",
          "garaging_mounts_required",
          "garaging_modules_required"
        ],
        "properties": {
          "size_category": {
            "type": "string",
            "enum": [
              "Medium",
              "Large",
              "Huge",
              "Gargantuan",
              "Colossal",
              "Enormous",
              "Titanic"
            ]
          },
          "scale_multiplier": {
            "type": "integer",
            "enum": [
              1,
              2,
              5,
              10,
              20,
              40,
              80
            ]
          },
          "garaging_mounts_required": {
            "type": "integer",
            "description": "Equals scale_multiplier"
          },
          "garaging_modules_required": {
            "type": "number",
            "description": "garaging_mounts_required / 10"
          }
        }
      },
      "structure_and_defense": {
        "type": "object",
        "required": [
          "table_base_sp_precalculated",
          "tl_sp_multiplier",
          "final_sp",
          "armor_dr",
          "defense_cr"
        ],
        "properties": {
          "table_base_sp_precalculated": {
            "type": "integer",
            "minimum": 1
          },
          "tl_sp_multiplier": {
            "type": "number",
            "minimum": 0.5
          },
          "final_sp": {
            "type": "integer",
            "minimum": 1
          },
          "armor_dr": {
            "type": "integer",
            "minimum": 0
          },
          "shield_dr": {
            "type": "integer",
            "minimum": 0
          },
          "defense_cr": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "udu_mounts": {
        "type": "object",
        "required": [
          "total_mounts_capacity",
          "mounts_allocated",
          "vft_extra_forms"
        ],
        "properties": {
          "total_mounts_capacity": {
            "type": "integer",
            "minimum": 1
          },
          "mounts_allocated": {
            "type": "integer",
            "minimum": 0
          },
          "vft_extra_forms": {
            "type": "integer",
            "minimum": 0,
            "description": "-10% Mount capacity per extra form"
          }
        }
      },
      "economics": {
        "type": "object",
        "required": [
          "final_crafting_cr",
          "credit_value",
          "pristine_material_cost_50pct",
          "scrap_mass_value_required_5x"
        ],
        "properties": {
          "final_crafting_cr": {
            "type": "integer",
            "minimum": 0
          },
          "credit_value": {
            "type": "integer",
            "minimum": 10
          },
          "pristine_material_cost_50pct": {
            "type": "integer",
            "minimum": 5
          },
          "scrap_mass_value_required_5x": {
            "type": "integer",
            "minimum": 50
          }
        }
      },
      "propulsion": {
        "type": "object",
        "required": [
          "system_type",
          "base_speed_ft",
          "scaled_tactical_speed_ft",
          "handling_mod"
        ],
        "properties": {
          "system_type": {
            "type": "string"
          },
          "base_speed_ft": {
            "type": "integer",
            "minimum": 0
          },
          "scaled_tactical_speed_ft": {
            "type": "integer",
            "minimum": 0
          },
          "handling_mod": {
            "type": "integer"
          }
        }
      },
      "automata_core": {
        "type": "object",
        "required": [
          "is_automata"
        ],
        "properties": {
          "is_automata": {
            "type": "boolean"
          },
          "processor_rating": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              4
            ]
          },
          "total_skill_ranks": {
            "type": "integer"
          },
          "max_skill_rank_cap": {
            "type": "integer"
          },
          "initiative_formula": {
            "type": "string"
          }
        }
      },
      "loadout": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "mounts_used",
            "base_damage",
            "scaled_damage"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "mounts_used": {
              "type": "integer",
              "minimum": 0
            },
            "base_damage": {
              "type": "string"
            },
            "scaled_damage": {
              "type": "string"
            },
            "range": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "ArchitectureAndBase": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tangent-rpg.bastion/schemas/architecture_base.schema.json",
    "title": "Tangent Tier 3 Architectural Structure Stat Block",
    "type": "object",
    "required": [
      "model_name",
      "footprint_size",
      "height_class",
      "tech_level",
      "frame_type",
      "faction_style",
      "statistics",
      "economics",
      "module_configuration"
    ],
    "properties": {
      "model_name": {
        "type": "string"
      },
      "footprint_size": {
        "type": "string"
      },
      "height_class": {
        "type": "string"
      },
      "stories": {
        "type": "integer",
        "minimum": 1
      },
      "tech_level": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5
      },
      "frame_type": {
        "type": "string",
        "enum": [
          "Industrial",
          "Standard",
          "Elevated",
          "Tower",
          "Subterranean",
          "Biomimetic",
          "Dynamic",
          "Palatial"
        ]
      },
      "faction_style": {
        "type": "string"
      },
      "statistics": {
        "type": "object",
        "required": [
          "structure_points_sp",
          "damage_resistance_dr",
          "total_modules_capacity",
          "is_mobile_structure"
        ],
        "properties": {
          "structure_points_sp": {
            "type": "integer",
            "minimum": 1
          },
          "damage_resistance_dr": {
            "type": "integer",
            "minimum": 0
          },
          "total_modules_capacity": {
            "type": "number",
            "minimum": 0.001
          },
          "is_mobile_structure": {
            "type": "boolean"
          },
          "mobile_chassis_tax_modules": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "economics": {
        "type": "object",
        "required": [
          "final_crafting_cr",
          "credit_value",
          "pristine_material_cost_50pct",
          "scrap_mass_value_required_5x",
          "annual_upkeep_2pct"
        ],
        "properties": {
          "final_crafting_cr": {
            "type": "integer",
            "minimum": 0
          },
          "credit_value": {
            "type": "integer",
            "minimum": 10
          },
          "pristine_material_cost_50pct": {
            "type": "integer",
            "minimum": 5
          },
          "scrap_mass_value_required_5x": {
            "type": "integer",
            "minimum": 50
          },
          "annual_upkeep_2pct": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "module_configuration": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "udu_type",
            "capacity_used",
            "role"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "udu_type": {
              "type": "string",
              "enum": [
                "Module",
                "Mount"
              ]
            },
            "capacity_used": {
              "type": "number",
              "minimum": 0
            },
            "component_cr": {
              "type": "integer",
              "minimum": 0
            },
            "role": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "PlanetarySystem": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tangent-rpg.bastion/schemas/planetary_system.schema.json",
    "title": "Tangent Planetary System & World Profile",
    "type": "object",
    "required": [
      "world_name",
      "sector",
      "controlling_faction",
      "astrophysics",
      "civilization",
      "hazards_and_encounters"
    ],
    "properties": {
      "world_name": {
        "type": "string"
      },
      "sector": {
        "type": "string"
      },
      "controlling_faction": {
        "type": "string"
      },
      "astrophysics": {
        "type": "object",
        "required": [
          "stellar_class",
          "gravity_g",
          "atmosphere_type",
          "hydrosphere_pct",
          "climate_band"
        ],
        "properties": {
          "stellar_class": {
            "type": "string"
          },
          "gravity_g": {
            "type": "number",
            "minimum": 0
          },
          "atmosphere_type": {
            "type": "string"
          },
          "hydrosphere_pct": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "climate_band": {
            "type": "string"
          }
        }
      },
      "civilization": {
        "type": "object",
        "required": [
          "population_tier",
          "government_type",
          "law_level",
          "starport_class",
          "tech_level",
          "meta_level",
          "trade_codes"
        ],
        "properties": {
          "population_tier": {
            "type": "string"
          },
          "government_type": {
            "type": "string"
          },
          "law_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "starport_class": {
            "type": "string",
            "enum": [
              "Class A",
              "Class B",
              "Class C",
              "Class D",
              "Class E",
              "Class X"
            ]
          },
          "tech_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "meta_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "trade_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "hazards_and_encounters": {
        "type": "object",
        "required": [
          "required_epr",
          "environmental_save_cr",
          "signature_hazards"
        ],
        "properties": {
          "required_epr": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "environmental_save_cr": {
            "type": "integer",
            "minimum": 5
          },
          "signature_hazards": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "EquipmentAndWeaponry": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tangent-rpg.bastion/schemas/equipment_weaponry_entity.schema.json",
    "title": "Tangent Tier 1 Equipment, Weaponry, Armor Layering & Cosmic Entity Schema",
    "type": "object",
    "required": [
      "asset_category",
      "designation",
      "tech_level",
      "meta_level",
      "faction_skin"
    ],
    "properties": {
      "asset_category": {
        "type": "string",
        "enum": [
          "Tier 1 Weapon",
          "Tier 1 Armor Loadout",
          "Cosmic Entity Profile"
        ]
      },
      "designation": {
        "type": "string"
      },
      "tech_level": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6
      },
      "meta_level": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6
      },
      "faction_skin": {
        "type": "string"
      },
      "udu_allocation": {
        "type": "object",
        "required": [
          "tier_0_nodes",
          "tier_1_sockets",
          "tier_2_mounts"
        ],
        "properties": {
          "tier_0_nodes": {
            "type": "number",
            "minimum": 0,
            "description": "10 Nodes = 1 Socket"
          },
          "tier_1_sockets": {
            "type": "number",
            "minimum": 0,
            "description": "10 Sockets = 1 Mount"
          },
          "tier_2_mounts": {
            "type": "number",
            "minimum": 0,
            "description": "10 Mounts = 1 Module"
          }
        }
      },
      "euft_economics": {
        "type": "object",
        "required": [
          "base_cr_tier",
          "micro_modifier_delta",
          "final_item_cr",
          "credit_value",
          "pristine_material_cost_50pct",
          "scrap_salvage_value_10pct",
          "scrap_mass_value_required_5x"
        ],
        "properties": {
          "base_cr_tier": {
            "type": "integer",
            "multipleOf": 5,
            "minimum": 0
          },
          "micro_modifier_delta": {
            "type": "integer",
            "minimum": -4,
            "maximum": 4
          },
          "micro_multiplier": {
            "type": "number",
            "enum": [
              0.25,
              0.75,
              1.0,
              1.3,
              1.75,
              2.3,
              3.0
            ]
          },
          "final_item_cr": {
            "type": "integer",
            "minimum": 0
          },
          "credit_value": {
            "type": "integer",
            "minimum": 1
          },
          "pristine_material_cost_50pct": {
            "type": "number",
            "minimum": 0.5
          },
          "scrap_salvage_value_10pct": {
            "type": "number",
            "minimum": 0.1
          },
          "scrap_mass_value_required_5x": {
            "type": "number",
            "minimum": 5
          }
        }
      },
      "weapon_profile": {
        "type": "object",
        "required": [
          "weapon_class",
          "governing_skill",
          "damage_dice",
          "damage_domain",
          "penetration",
          "critical_protocol",
          "fumble_protocol",
          "range_increment_ft"
        ],
        "properties": {
          "weapon_class": {
            "type": "string"
          },
          "governing_skill": {
            "type": "string",
            "enum": [
              "Melee",
              "Brawl",
              "Ballistic",
              "Energy Weapons",
              "Heavy Weapons",
              "Athletics"
            ]
          },
