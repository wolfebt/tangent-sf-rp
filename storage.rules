rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Character folio image slot files: users/{userId}/personas/{personaId}/{slotFile}
    // Enforces user ownership, 350 KB client-compression quota, and allowed slot patterns
    match /users/{userId}/personas/{personaId}/{slotFile} {
      
      // Allow direct asset fetch by authenticated session participants, while scoping directory listing to owner
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.auth.uid == userId;

      // Allow create/update ONLY if:
      // 1. The user owns this directory
      // 2. Upload payload exists and size does not exceed 350 KB (enforces client-side WebP compression)
      // 3. Content type is an image
      // 4. File name matches canonical slot names: portrait, token, standee, or gallery index
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource != null
        && request.resource.size <= 350 * 1024
        && request.resource.contentType.matches('image/(webp|png|jpeg)')
        && slotFile.matches('^(portrait|token|standee|gallery_[0-9]+)[.](webp|png|jpg)$');

      // Allow deletion only by the owner
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ADE Story Foundry media assets: users/{userId}/ade/{assetCategory}/{fileName}
    // Supports story handouts, map plates, element portraits, tokens, and backdrops
    match /users/{userId}/ade/{assetCategory}/{fileName} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource != null
        && assetCategory.matches('^(story_media|maps|elements|tokens|handouts)$')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|png|jpeg)')
        && !fileName.matches('.*\\.\\..*')
        && fileName.matches('^[A-Za-z0-9][A-Za-z0-9._-]*[.](webp|png|jpg|jpeg)$');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
