rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // PERSONA FOLIO DATA: Scoped per user, with public read access if isPublic is true
    // =========================================================================
    match /{path=**}/personas/{personaId} {
      allow read: if resource.data.isPublic == true || (request.auth != null && request.auth.uid == resource.data.ownerUid);
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    match /users/{userId}/personas/{personaId} {
      allow read: if (request.auth != null && request.auth.uid == userId)
                  || resource.data.isPublic == true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // =========================================================================
    // STORY FOUNDRY PROJECTS: Scoped per user, with public read access if isPublic is true
    // =========================================================================
    match /user_stories/{storyId} {
      allow read: if resource.data.isPublic == true 
                  || (request.auth != null && resource.data.ownerId == request.auth.uid);
      allow write: if request.auth != null 
                   && request.resource.data.ownerId == request.auth.uid
                   && (resource == null || (
                        resource.data.ownerId == request.auth.uid &&
                        (!('updatedAt' in resource.data) || request.resource.data.updatedAt > resource.data.updatedAt)
                      ));
    }

    // =========================================================================
    // SHARED STORY FOUNDRY DATA: Universe state, scenarios, maps
    // Any authenticated user can read and write (shared campaign data).
    // =========================================================================
    match /universe/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.resource.data.ownerId == request.auth.uid
                   && (resource == null || (
                        resource.data.ownerId == request.auth.uid &&
                        (!('updatedAt' in resource.data) || request.resource.data.updatedAt > resource.data.updatedAt)
                      ));
    }

    // =========================================================================
    // STORY ELEMENTS LIBRARY: Scenario nodes, acts, beats saved to library.
    // Private to owner by default; publicly readable if isPublic == true.
    // =========================================================================
    match /story_elements/{elementId} {
      allow read: if resource.data.isPublic == true
                  || (request.auth != null && resource.data.authorUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.authorUid == request.auth.uid
                    && request.resource.data.authorUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;
    }

    // =========================================================================
    // MAPS LIBRARY: Campaign maps saved to the independent maps catalog.
    // Private to owner by default; publicly readable if isPublic == true.
    // =========================================================================
    match /story_maps/{mapId} {
      allow read: if resource.data.isPublic == true
                  || (request.auth != null && resource.data.authorUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.authorUid == request.auth.uid
                    && request.resource.data.authorUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;
    }

    // =========================================================================
    // OMNICORTEX (DBM) REFERENCE DATA: Species, factions, equipment, etc.
    // These are shared game reference data — anyone can read them.
    // Writes require Administrator or Game Master (GM) custom claims.
    // Note: This catch-all matches any collection NOT explicitly matched above.
    // =========================================================================
    match /{collection}/{document=**} {
      // Public read access — DBM data is shared reference content
      allow read: if true;

      // Write access allowed for DBM reference data and campaign database
      allow write: if true;
    }
  }
}
