rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.token.role == 'GM');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // 1. OMNICORTEX (DBM) REFERENCE COLLECTIONS: Public Read, Admin/GM Write
    // =========================================================================
    match /compendium/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /species/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /origins/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /factions/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /equipment/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cybernetics/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /psionics/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /disciplines/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /skills/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /features/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /traits/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /flaws/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /attributes/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /prerequisite/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /species_type/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /species_size/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /species_movement/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /trait/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /modifier/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /societies/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gear_category/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /vehicles/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gear/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /rules/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /disadvantages/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /occupations/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /invocations/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /synthesis/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /maneuvers/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /conditions/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /damage_types/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 2. USER PROFILES & USER SETTINGS
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // 3. GAME GROUPS & SQUAD ROSTERS
    // =========================================================================
    match /game_groups/{groupId} {
      allow read: if isAuthenticated() || resource.data.isPublic == true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // 4. GROUP & SQUAD INVITATIONS
    // =========================================================================
    match /group_invites/{inviteId} {
      allow read: if isAuthenticated() && (
        resource.data.toUserId == request.auth.uid 
        || resource.data.fromUserId == request.auth.uid 
        || isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.toUserId == request.auth.uid 
        || resource.data.fromUserId == request.auth.uid 
        || isAdmin()
      );
    }

    // =========================================================================
    // 5. PERSONA FOLIO DATA & CHARACTERS
    // =========================================================================
    match /users/{userId}/personas/{personaId} {
      allow read: if isOwner(userId) || resource.data.isPublic == true || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /{path=**}/personas/{personaId} {
      allow read: if resource.data.isPublic == true 
                  || (isAuthenticated() && (request.auth.uid == resource.data.ownerUid || isAdmin()));
      allow write: if isAuthenticated() && (request.auth.uid == resource.data.ownerUid || isAdmin());
    }

    match /characters/{charId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.ownerId == request.auth.uid || resource.data.isPublic == true || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // 6. STORY FOUNDRY: USER STORIES & CAMPAIGNS
    // =========================================================================
    match /user_stories/{storyId} {
      allow read: if resource.data.isPublic == true 
                  || (isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.creatorId == request.auth.uid || isAdmin()));
      allow create: if isAuthenticated() && (request.resource.data.ownerId == request.auth.uid || request.resource.data.creatorId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.creatorId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // 7. STORY FOUNDRY: INDEPENDENT SCENARIO ELEMENTS
    // =========================================================================
    match /story_elements/{elementId} {
      allow read: if resource.data.isPublic == true 
                  || (isAuthenticated() && (resource.data.authorUid == request.auth.uid || resource.data.creatorId == request.auth.uid || isAdmin()));
      allow create: if isAuthenticated() && (request.resource.data.authorUid == request.auth.uid || request.resource.data.creatorId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || resource.data.creatorId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // 8. STORY FOUNDRY: TACTICAL MAPS
    // =========================================================================
    match /story_maps/{mapId} {
      allow read: if isAuthenticated() || resource.data.isPublic == true;
      allow create: if isAuthenticated() && (request.resource.data.authorUid == request.auth.uid || request.resource.data.creatorId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || resource.data.creatorId == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // 9. STORY FOUNDRY: SHARED UNIVERSE STATE
    // =========================================================================
    match /universe/{document=**} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.ownerEmail == request.auth.token.email ||
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.ownerEmail == request.auth.token.email ||
        resource.data.authorUid == request.auth.uid ||
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
    }

    // =========================================================================
    // 10. COMMLINK RELAY: CHANNELS & MESSAGES
    // =========================================================================
    match /channels/{channelId} {
      // Allow read if channel is public or user is in members or is admin
      allow read: if resource.data.isPublic == true 
                  || resource.data.type == 'public'
                  || (isAuthenticated() && (
                       (resource.data.members != null && request.auth.uid in resource.data.members)
                       || resource.data.createdById == request.auth.uid
                       || isAdmin()
                     ));
      allow create: if isAuthenticated() || isAdmin();
      allow update: if isAuthenticated() && (
                       resource.data.isPublic == true
                       || (resource.data.members != null && request.auth.uid in resource.data.members)
                       || resource.data.createdById == request.auth.uid 
                       || isAdmin()
                     );
      allow delete: if isAuthenticated() && (
                       !channelId.matches('public_.*') 
                       && (resource.data.createdById == request.auth.uid || isAdmin())
                     );

      // Subcollection: Channel Messages
      match /messages/{messageId} {
        allow read: if get(/databases/$(database)/documents/channels/$(channelId)).data.isPublic == true
                    || get(/databases/$(database)/documents/channels/$(channelId)).data.type == 'public'
                    || (isAuthenticated() && (
                         request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.members
                         || get(/databases/$(database)/documents/channels/$(channelId)).data.createdById == request.auth.uid
                         || isAdmin()
                       ));
        allow create: if isAuthenticated() || isAdmin();
        allow update, delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    // =========================================================================
    // 11. FINAL CATCH-ALL: EXPLICIT DENY
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
