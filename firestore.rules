rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default fallback - deny everything that isn't explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for Tangent SF RP Omnicortex (DBM)
    // Matches all collections like rules_codex, species, factions, equipment, etc.
    match /{collection}/{document=**} {
      // Allow any authenticated user to read the database
      allow read: if request.auth != null;
      
      // Allow any authenticated user to write (for development)
      allow write: if request.auth != null;

      // =========================================================================
      // PRODUCTION RECOMMENDATION:
      // Replace the `allow write` above with the line below to lock down writes
      // only to users who have a specific 'GM' (Game Master) custom claim.
      // 
      // allow write: if request.auth != null && request.auth.token.role == 'GM';
      // =========================================================================
    }
  }
}
