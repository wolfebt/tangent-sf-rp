# Normalize line endings: LF in the repository and working tree (avoids LF->CRLF churn warnings on Windows).
* text=auto eol=lf

# Windows-native scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.wasm binary
*.glb binary
*.mp3 binary
*.ogg binary
*.wav binary
*.mp4 binary
*.pdf binary
*.zip binary
