# ==============================================================================
# TANGENT SF RP - Environment Configuration Template
# Copy this file to .env and configure your keys.
# DO NOT commit .env with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Web Configuration
# Note: In Firebase Web SDK architecture, these values identify your Firebase
# project and are bundled into client-side JS. Access control is enforced via
# Firestore Security Rules and App Check.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=tangent-rpg-dbm.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tangent-rpg-dbm
VITE_FIREBASE_STORAGE_BUCKET=tangent-rpg-dbm.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ------------------------------------------------------------------------------
# 2. Google Gemini AI (BASTION & AIME)
# Recommended for production: Users can enter their personal Gemini API key
# in Omnicortex / DBM Settings (persisted securely in browser localStorage).
# Optional development fallback: Set VITE_GEMINI_API_KEY here.
# Note: Any variable prefixed with VITE_ is bundled into client-side JS on build.
# ------------------------------------------------------------------------------
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. LiveKit Tactical Voice Configuration
# Recommended for production: Set VITE_LIVEKIT_TOKEN_ENDPOINT to an authenticated
# backend service / Cloud Function that generates participant JWTs securely.
#
# For offline / local development testing only: You may supply API key & secret,
# but NEVER deploy production builds with VITE_LIVEKIT_API_SECRET enabled,
# as Vite bundles VITE_ variables into public client code.
# ------------------------------------------------------------------------------
VITE_LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
VITE_LIVEKIT_TOKEN_ENDPOINT=
VITE_LIVEKIT_API_KEY=your_livekit_api_key
VITE_LIVEKIT_API_SECRET=your_livekit_api_secret
