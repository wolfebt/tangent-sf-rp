{
  "name": "tangent-sfr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/syncMasterCanonicalCompendium.mjs && tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:all": "npm run build && firebase deploy",
    "sync:compendium": "node scripts/syncMasterCanonicalCompendium.mjs",
    "verify:rules": "node scripts/verifyRulesFidelity.mjs",
    "sync:species": "node scripts/syncOmnicortexSpecies.mjs",
    "sync:species-traits": "node scripts/syncSpeciesTraits.mjs",
    "sync:species-disadvantages": "node scripts/syncSpeciesDisadvantages.mjs",
    "build:data": "node scripts/buildAllBundles.mjs",
    "test:data": "node scripts/validateDataIntegrity.mjs",
    "test:engine": "node --test \"tests/engine/*.test.mjs\" \"src/engines/__tests__/*.test.js\" \"src/services/*.test.mjs\" \"src/schemas/*.test.mjs\" \"src/components/VTT/tree/*.test.mjs\"",
    "test:security": "node --test \"tests/engine/firestoreRulesSecurity.test.mjs\"",
    "test:security:emulator": "firebase emulators:exec --only firestore \"node --test tests/engine/firestoreRulesSecurity.test.mjs\"",
    "test:functions": "node --test \"tests/engine/cloudFunctions.test.mjs\"",
    "test:fuzz": "node --test \"tests/engine/propertyFuzzSuite.test.mjs\"",
    "test:stores": "node --test \"tests/engine/vttAndStageStores.test.mjs\" \"tests/engine/adeStoreCentralization.test.mjs\"",
    "test:hooks": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:e2e:journeys": "playwright test tests/e2e/user-journeys.spec.ts",
    "test:e2e:a11y": "playwright test tests/e2e/accessibility-and-pwa.spec.ts",
    "test:e2e:visual": "playwright test tests/e2e/canvas-visual-regression.spec.ts --project=chromium-webgl",
    "test": "node scripts/syncMasterCanonicalCompendium.mjs && npm run verify:rules && npm run test:engine && npm run test:hooks && node scripts/validateDataIntegrity.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.3",
    "fast-check": "^4.10.2",
    "firebase-admin": "^14.2.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.4",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@google/genai": "^2.25.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "dompurify": "^3.4.13",
    "firebase": "^12.16.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "immer": "^11.1.15",
    "konva": "^10.3.0",
    "livekit-client": "^2.22.2",
    "lucide-react": "^1.31.0",
    "marked": "^18.0.9",
    "pixi.js": "^8.20.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-konva": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^7.18.1",
    "react-split": "^2.0.14",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1",
    "uuid": "^14.0.1",
    "yjs": "^13.6.32",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  }
}
